# VibeFlow Python Music Discovery Microservice Environment Template
# Used by music-service/run.py (derived from MUSIC_SERVICE_URL or MUSIC_SERVICE_PORT)

FLASK_ENV=development
MUSIC_SERVICE_HOST=127.0.0.1
MUSIC_SERVICE_PORT=5001
MUSIC_SERVICE_URL=http://127.0.0.1:5001
INTERNAL_SERVICE_TOKEN=
REQUEST_TIMEOUT_SECONDS=8
