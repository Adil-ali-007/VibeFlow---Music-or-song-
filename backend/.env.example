# VibeFlow Standalone Express Backend Environment Template

NODE_ENV=development
PORT=8000
BACKEND_PORT=8000
PUBLIC_URL=http://localhost:8000

# Allowed Frontend Origins for CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB & Session Signing Settings (REQUIRED in production)
MONGODB_URI=
JWT_SECRET=

# Python Music Discovery Microservice
MUSIC_SERVICE_URL=http://127.0.0.1:5001
INTERNAL_SERVICE_TOKEN=

# Initial Admin Bootstrap (Used only by `npm run admin:bootstrap`)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
