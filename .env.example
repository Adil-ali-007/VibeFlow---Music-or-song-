# VibeFlow Root Environment Configuration Template
# Copy this file to .env and populate values privately. Never commit .env to Git!

NODE_ENV=development

# Server Port & Public URL Assignments
# - Unified Mode (`npm run dev` / `npm start`): Full-stack Express + SPA listens on PORT=3000
# - Separate-Service Mode: Express API listens on BACKEND_PORT=8000, Vite dev server on 5173
PORT=3000
BACKEND_PORT=8000
PUBLIC_URL=http://localhost:3000

# Frontend & CORS Origins
# Comma-separated list of additional trusted origins if frontend is hosted on a separate domain
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend API Base URL
# Use /api for unified mode (port 3000) or Vite proxy mode (port 5173).
# If hosting the React SPA separately (e.g. Vercel/Cloudflare Pages), set to https://your-api-host.example.com/api
VITE_API_URL=/api
BACKEND_URL=http://127.0.0.1:8000

# MongoDB Connection URI (REQUIRED in production: mongodb:// or mongodb+srv://)
MONGODB_URI=

# JWT Session Cookie Signing Secret (REQUIRED in production: minimum 32 random characters)
JWT_SECRET=

# Python Music Discovery Microservice Configuration
MUSIC_SERVICE_HOST=127.0.0.1
MUSIC_SERVICE_PORT=5001
MUSIC_SERVICE_URL=http://127.0.0.1:5001
REQUEST_TIMEOUT_SECONDS=8

# Shared secret between Express backend and Python music service (X-Internal-Token header).
# Must match in both Express and Python if set.
INTERNAL_SERVICE_TOKEN=

# Initial Administrator Provisioning (Used only by `npm run admin:bootstrap`)
# Never commit real admin emails or passwords to version control.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
